# hCG Biology Academy Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.
# Do NOT commit actual secrets or credentials to public Git repositories!

# -------------------------------------------------------------
# 1. CORE ACADEMY SETTINGS
# -------------------------------------------------------------
NEXT_PUBLIC_ACADEMY_NAME="hCG Biology Academy"
NEXT_PUBLIC_TAGLINE="Where Biology Comes to Life"
NEXT_PUBLIC_SYLLABUS_CODE="9700"
NEXT_PUBLIC_PROGRAMME="Cambridge AS & A Level Biology"

# Official communication details
NEXT_PUBLIC_ADMISSIONS_EMAIL="your_email@example.com"
NEXT_PUBLIC_ADMISSIONS_PHONE="+92 300 0000000"
NEXT_PUBLIC_WHATSAPP_NUMBER="923000000000"

# -------------------------------------------------------------
# 2. SUPABASE STORAGE & DATABASE INTEGRATION
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# -------------------------------------------------------------
# 3. GOOGLE FORMS DIRECT INTEGRATION (OPTIONAL)
# -------------------------------------------------------------
GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/.../formResponse"

GOOGLE_FORM_ENTRY_FULLNAME="entry.000000000"
GOOGLE_FORM_ENTRY_EMAIL="entry.000000000"
GOOGLE_FORM_ENTRY_WHATSAPP="entry.000000000"
GOOGLE_FORM_ENTRY_COUNTRY="entry.000000000"
GOOGLE_FORM_ENTRY_CITY="entry.000000000"
GOOGLE_FORM_ENTRY_SCHOOL="entry.000000000"
GOOGLE_FORM_ENTRY_PROGRAMME="entry.000000000"
GOOGLE_FORM_ENTRY_SYLLABUS="entry.000000000"
GOOGLE_FORM_ENTRY_LEARNING_MODE="entry.000000000"
GOOGLE_FORM_ENTRY_BACKGROUND="entry.000000000"
GOOGLE_FORM_ENTRY_TIMING="entry.000000000"
GOOGLE_FORM_ENTRY_SOURCE="entry.000000000"
GOOGLE_FORM_ENTRY_MESSAGE="entry.000000000"

# -------------------------------------------------------------
# 4. APP ENVIRONMENT
# -------------------------------------------------------------
NODE_ENV="development"
PORT=3000
